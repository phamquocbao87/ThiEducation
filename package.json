{
  "name": "lakeducation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.landing.config.js && vite build --config vite.erp.config.js",
    "build:landing": "vite build --config vite.landing.config.js",
    "build:erp": "vite build --config vite.erp.config.js",
    "deploy:landing": "npm run build:landing && firebase deploy --only hosting:landing",
    "deploy:erp": "npm run build:erp && firebase deploy --only hosting:erp",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^6.6.1",
    "i18next": "^26.7.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.1.12",
    "react-router-dom": "^7.18.2",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
